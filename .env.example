# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).

# --- Core secrets ---
SECRET_KEY=your-secret-key-min-32-chars
ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# --- Database ---
# Default if unset: sqlite+aiosqlite:///./wealth_planning.db
# Postgres (local compose shown; Azure uses the managed-server connection string):
DATABASE_URL=postgresql+asyncpg://wpapp:wpapp_local_pw@localhost:5433/wealth_planning
# Schema is managed by Alembic (`alembic upgrade head`). Keep false in real envs.
RUN_CREATE_ALL_ON_STARTUP=false

# --- Vector store (ChromaDB) ---
# embedded (default) reads CHROMA_DB_PATH on local disk; http talks to a Chroma server.
CHROMA_MODE=embedded
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false

# --- File storage ---
# local (default) writes to UPLOADS_PATH / REPORTS_PATH; azure uses Blob storage.
STORAGE_BACKEND=local
# Below is the PUBLIC, well-known Azurite emulator dev connection string (not a secret).
# In Azure, replace with the real Storage account connection string.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_BLOB_CONTAINER=wpapp

# --- Azure Entra ID SSO (optional) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- SMTP for transactional email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Lighthouse Canton Wealth Planning
